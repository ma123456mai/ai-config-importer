{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "cc-switch",
  "name": "AI Config Importer",
  "version": "0.1.4",
  "publisher": "ma123456mai",
  "description": "Import AI provider configurations from CC-SWITCH into DBX.",
  "icon": "assets/plugin.png",
  "source": "https://github.com/ma123456mai/dbx-cc-switch-plugin",
  "homepage": "https://github.com/ma123456mai/dbx-cc-switch-plugin",
  "engines": {
    "dbx": ">=0.6.15",
    "host_api": "1"
  },
  "permissions": [],
  "entrypoints": {
    "backend": {
      "executable": "bin/cc-switch-importer"
    }
  },
  "capabilities": [
    {
      "id": "ai-config-import",
      "label": "AI configuration import",
      "kind": "ai-config-import"
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "AI 配置导入",
      "description": "从 CC-SWITCH 导入 AI 提供商配置到 DBX。"
    }
  }
}
